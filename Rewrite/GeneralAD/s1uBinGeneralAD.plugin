#!name=GeneralAD Enhance
#!desc=GeneralAD Enhance
#!author=s1uBin
#!system=iOS,iPadOS,tvOS,macOS
#!loon_version=3.5.0(975)

[Argument]
blockUpload = switch,true,tag=Block Upload Button
blockImmersive = switch,true,tag=Block Immersive Button
blockShorts = switch,false,tag=Block Shorts Button
captionLang = input,"off",tag=Caption Translation Language
debug = switch,false,tag=Enable Debug Mode

[Rule]
#Google Ads / Ad Manager
#DOMAIN-SUFFIX,googlesyndication.com,REJECT
#DOMAIN-SUFFIX,doubleclick.net,REJECT
#DOMAIN-SUFFIX,googletagservices.com,REJECT
#DOMAIN-SUFFIX,googleadservices.com,REJECT
#AMP Ads
URL-REGEX,"^https?://cdn.ampproject.org/./amp-ad-..mjs",REJECT
URL-REGEX,"^https?://cdn.ampproject.org/./amp4ads..mjs",REJECT
#Toy-People AD API
#URL-REGEX,"^https?://www.toy-people.com/ajax/toy-ad.php",REJECT
#Google Ad-block recovery / ad related endpoint
URL-REGEX,"^https?://fundingchoicesmessages.google.com/i/pub-8644626422197562",REJECT
#video-ad
URL-REGEX,"^https?://fundingchoicesmessages.google.com/f/.*/controller.ad..*video-ad",REJECT

[Script]
#http-response ^https:\/\/www\.toy-people\.com\/ script-path=https://raw.githubusercontent.com/s1uBin/JSTesting/refs/heads/main/Rewrite/GeneralAD/test.js,requires-body=true,timeout=20,tag=Toy-People Ad Clean,enable=true
http-response ^https:\/\/www\.toy-people\.com\/$ script-path=https://raw.githubusercontent.com/s1uBin/JSTesting/refs/heads/main/Rewrite/GeneralAD/test.js,requires-body=true,timeout=20,tag=Toy-People Ad Clean,enable=true
[Mitm]
hostname = *.toy-people.com
