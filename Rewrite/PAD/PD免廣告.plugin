#!name=PD免廣告(主腳本)
#!desc=攔截Puzzle&Dragons的廣告獎勵API並自動捕獲樣本。
#!author=local

[Script]
http-request ^https?:\/\/[^\/]*padsv\.gungho\.jp\/.*$ script-path=https://raw.githubusercontent.com/s1uBin/JSTesting/refs/heads/main/Rewrite/PAD/PD_capture.js, timeout=10, tag=PD攔截-請求
http-response ^https?:\/\/[^\/]*padsv\.gungho\.jp\/.*$ script-path=https://raw.githubusercontent.com/s1uBin/JSTesting/refs/heads/main/Rewrite/PAD/PD_capture.js, requires-body=true, timeout=10, tag=PD攔截-回應

[MITM]
hostname = %APPEND% padsv.gungho.jp